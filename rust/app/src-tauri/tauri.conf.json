{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seraphine Rust",
  "version": "2.0.0",
  "identifier": "com.seraphine.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Seraphine",
        "width": 1134,
        "height": 826,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2N0Q3OUIyNjI5MDhDNDkKUldSSmpKQmlzbmw5Umo5QWlHZUVmeDJSWS9rL3RyVDYyQkhtdUhxUkJTbmhBYXM0R1h4NFdFNVgK",
      "endpoints": [
        "https://github.com/Mcloud136/Seraphine-rust/releases/download/updater/latest.json"
      ]
    }
  }
}